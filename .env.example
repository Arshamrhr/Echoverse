# Copy this to .env and fill in real values. .env itself is gitignored.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-value

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-to-a-long-random-value

# Get this from Keycloak after first boot (see README step 2):
# Admin console -> Clients -> anime-backend -> Credentials -> Regenerate secret
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-after-first-boot
