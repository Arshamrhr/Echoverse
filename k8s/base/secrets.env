# Copy to secrets.env and fill in real values before deploying.
# secrets.env is gitignored — never commit real credentials.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-value
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-to-a-long-random-value
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-after-first-boot
DATABASE_URL=postgresql://postgres:change-me-to-a-long-random-value@postgres:5432/echoverse_db
